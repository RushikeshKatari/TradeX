# PostgreSQL Database URL (Neon, Supabase, Vercel Postgres, or local PostgreSQL)
# Example: postgresql://user:password@ep-cool-frost-123456.ap-southeast-1.aws.neon.tech/tradex?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradex?schema=public"

# Authentication Secret (minimum 32 characters for JOSE HS256)
AUTH_SECRET="tradex_super_secret_session_jwt_key_at_least_32_chars_2026"

# Market Data Configuration
# Values: "live" | "development"
# In "live" mode: only real provider data is used; missing/invalid credentials will fail safely.
# In "development" mode: deterministic offline market fixtures are provided for local dev & tests.
MARKET_DATA_MODE="development"
MARKET_DATA_API_KEY=""
MARKET_DATA_API_URL="https://query1.finance.yahoo.com"

# Admin Initial Seed (used on npm run db:seed)
ADMIN_EMAIL="admin@tradex.local"
ADMIN_PASSWORD="AdminSecurePassword123!"

# Application Port
PORT=3000
